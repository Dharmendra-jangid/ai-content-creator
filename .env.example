# Environment variables
#
# Copy this file to `.env.local` for local development.
# Never commit real secrets.

# App URL — no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MySQL (Prisma)
# Local Docker: docker compose up -d
DATABASE_URL="mysql://root:aurateria@127.0.0.1:3306/aurateria"

# Signed login cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google Gemini — server only. Never NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Google login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional Razorpay — leave unset until payments go live
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# BILLING_PAYMENTS_ENABLED=true
